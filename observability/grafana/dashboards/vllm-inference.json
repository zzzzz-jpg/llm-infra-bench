          "instant": false,
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "inference:output_tokens_per_second:by_pod{model_name=~\"$model\"}",
          "legendFormat": "{{pod}}",
