          "legendFormat": "achieved",
          "refId": "A",
          "range": true,
          "instant": false,
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(nginx_ingress_controller_requests{service=~\".*vllm.*\"}[2m]))",
          "legendFormat": "offered (gateway)",
          "refId": "REF",
          "range": true,
          "instant": false,
